<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="data:,">
<title>Chatbot lọc khách theo hạng A-score</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F3F5F7; --surface:#FFFFFF; --surface2:#EDF1F4; --surface3:#E6ECF1;
  --text:#13202E; --muted:#5A6B7B; --muted2:#8494A3;
  --line:#D9E1E7; --brand:#0B4F9C; --brand-dark:#083A73; --brand-soft:#E3EDF8;
  --pass:#0E7A3E; --pass-bg:#E6F4EA; --pass-line:#A8D8B8;
  --fail:#B42318; --fail-bg:#FDECEA; --fail-line:#F0B3AE;
  --warn:#8A5A00; --warn-bg:#FFF3D1; --warn-line:#EAC86A;
  --bot-bg:#EDF2F7; --user-bg:#0B4F9C; --user-text:#fff;
  --shadow:0 6px 24px rgba(19,32,46,.08);
  --radius:16px;
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#0E151C; --surface:#17222D; --surface2:#1D2B38; --surface3:#243646;
    --text:#EAF1F6; --muted:#9FB0BE; --muted2:#7C8FA0;
    --line:#2A3D4E; --brand:#4D9DE0; --brand-dark:#7AB8EE; --brand-soft:#1A3350;
    --pass:#4CC27E; --pass-bg:#123324; --pass-line:#1F5C3A;
    --fail:#FF8A80; --fail-bg:#3A1D1A; --fail-line:#6E322C;
    --warn:#F2C94C; --warn-bg:#3A2F10; --warn-line:#6B5716;
    --bot-bg:#1D2B38; --user-bg:#1663B8; --shadow:0 6px 24px rgba(0,0,0,.35);
  }
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:"Be Vietnam Pro",system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--text);line-height:1.55;font-size:15.5px}
a{color:var(--brand)}
button,input{font:inherit}
button{min-height:44px;cursor:pointer}
.wrap{max-width:1120px;margin:0 auto;padding:18px 16px 40px}
.intro{padding:6px 2px 16px}
.intro h1{font-size:clamp(24px,4.5vw,34px);line-height:1.15;margin:0 0 8px;font-weight:800;letter-spacing:-.02em}
.intro p{margin:0;color:var(--muted);max-width:720px;font-size:15px}
.meta-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.pill{display:inline-flex;align-items:center;gap:6px;background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:6px 11px;font-size:12.5px;font-weight:600;color:var(--muted)}
.pill strong{color:var(--text)}
.pill .dot{width:8px;height:8px;border-radius:50%;background:var(--pass);flex:none}
.layout{display:grid;grid-template-columns:1fr 340px;gap:16px;align-items:start}
@media(max-width:900px){.layout{grid-template-columns:1fr}}

/* Chat card */
.chat-card{background:var(--surface);border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow);overflow:hidden}
.chat-head{display:flex;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid var(--line)}
.avatar{width:44px;height:44px;border-radius:50%;background:var(--brand);color:#fff;display:grid;place-items:center;font-weight:800;font-size:15px;flex:none;letter-spacing:.02em}
.chat-head .who{flex:1;min-width:0}
.chat-head .who b{display:block;font-size:15px}
.chat-head .who span{font-size:12.5px;color:var(--muted);display:flex;align-items:center;gap:6px}
.online{width:8px;height:8px;border-radius:50%;background:#22A55B;display:inline-block}
.btn-ghost{background:transparent;border:1px solid var(--line);color:var(--text);border-radius:999px;padding:8px 14px;font-weight:600;font-size:13.5px;min-height:40px}
.btn-ghost:hover{border-color:var(--brand);color:var(--brand)}
.progress{height:6px;background:var(--surface2)}
.progress i{display:block;height:100%;background:var(--brand);width:8%;transition:width .4s ease;border-radius:0 99px 99px 0}
.step-label{padding:8px 16px 0;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted2)}
.chat-log{padding:14px 16px 8px;display:flex;flex-direction:column;gap:12px;min-height:340px;max-height:62vh;overflow-y:auto}
.msg{display:flex;gap:9px;max-width:92%}
.msg.bot{align-self:flex-start}
.msg.user{align-self:flex-end;flex-direction:row-reverse}
.msg .mini{width:30px;height:30px;border-radius:50%;background:var(--brand-soft);color:var(--brand);display:grid;place-items:center;font-size:11px;font-weight:800;flex:none;margin-top:2px}
.msg.user .mini{background:var(--surface3);color:var(--muted)}
.bubble{padding:11px 13px;border-radius:16px;font-size:14.5px;line-height:1.6}
.msg.bot .bubble{background:var(--bot-bg);border-bottom-left-radius:4px}
.msg.user .bubble{background:var(--user-bg);color:var(--user-text);border-bottom-right-radius:4px}
.bubble p{margin:0 0 8px}.bubble p:last-child{margin-bottom:0}
.bubble ul{margin:6px 0 0;padding-left:18px}.bubble li{margin:3px 0}
.bubble .say{background:var(--surface);border:1px dashed var(--line);border-radius:10px;padding:9px 11px;margin-top:8px;font-size:13.5px}
@media(prefers-color-scheme:dark){.bubble .say{background:var(--surface)}}
.bubble .say b{color:var(--brand)}
.typing{display:inline-flex;gap:5px;padding:13px 14px;background:var(--bot-bg);border-radius:16px;border-bottom-left-radius:4px}
.typing i{width:7px;height:7px;border-radius:50%;background:var(--muted2);animation:blink 1.1s infinite}
.typing i:nth-child(2){animation-delay:.18s}.typing i:nth-child(3){animation-delay:.36s}
@keyframes blink{0%,80%,100%{opacity:.25}40%{opacity:1}}
@media(prefers-reduced-motion:reduce){.typing i{animation:none}html{scroll-behavior:auto}}

/* Result inside chat */
.result{border-radius:14px;padding:13px 14px;margin-top:4px;border:1.5px solid}
.result.pass{background:var(--pass-bg);border-color:var(--pass-line)}
.result.fail{background:var(--fail-bg);border-color:var(--fail-line)}
.result.warn{background:var(--warn-bg);border-color:var(--warn-line)}
.result .verdict{font-weight:800;font-size:16px;display:flex;gap:8px;align-items:flex-start;line-height:1.35}
.result.pass .verdict{color:var(--pass)} .result.fail .verdict{color:var(--fail)} .result.warn .verdict{color:var(--warn)}
.result .why{font-size:13.5px;margin-top:7px;color:var(--text)}
.result table{width:100%;border-collapse:collapse;margin-top:10px;font-size:13px;background:var(--surface);border-radius:10px;overflow:hidden}
.result table td,.result table th{padding:7px 9px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
.result table tr:last-child td{border-bottom:none}
.result table th{color:var(--muted);font-weight:600;width:46%}
.result .next{font-size:13.5px;margin-top:9px;padding-top:9px;border-top:1px dashed var(--line)}

/* Controls */
.controls{border-top:1px solid var(--line);padding:14px 16px 16px;background:var(--surface)}
.controls .hint{font-size:12.5px;color:var(--muted);margin:0 0 10px}
.choices{display:flex;flex-wrap:wrap;gap:9px}
.choice{flex:1 1 140px;border:1.5px solid var(--line);background:var(--surface);color:var(--text);border-radius:13px;padding:11px 13px;text-align:left;font-weight:600;font-size:14.5px;line-height:1.4;min-height:52px}
.choice small{display:block;font-weight:400;color:var(--muted);font-size:12.5px;margin-top:2px}
.choice:hover{border-color:var(--brand)}
.choice.primary{background:var(--brand);border-color:var(--brand);color:#fff}
.choice.primary small{color:#D6E6F7}
.score-form{display:flex;gap:9px;flex-wrap:wrap}
.score-form input{flex:1 1 170px;min-height:52px;border:1.5px solid var(--line);border-radius:13px;padding:10px 14px;font-size:18px;font-weight:700;background:var(--surface);color:var(--text)}
.score-form input:focus{outline:2px solid var(--brand);outline-offset:1px;border-color:var(--brand)}
.btn-main{background:var(--brand);color:#fff;border:none;border-radius:13px;padding:11px 20px;font-weight:700;min-height:52px}
.btn-main:hover{background:var(--brand-dark)}
.months-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:7px}
@media(max-width:520px){.months-grid{grid-template-columns:repeat(5,1fr)}}
.month-btn{border:1.5px solid var(--line);background:var(--surface);color:var(--text);border-radius:11px;font-weight:700;font-size:15px;min-height:48px;padding:6px 2px}
.month-btn:hover{border-color:var(--brand);color:var(--brand)}
.month-btn.zone-bad:hover{border-color:var(--fail);color:var(--fail)}
.month-btn.zone-good:hover{border-color:var(--pass);color:var(--pass)}
.err{color:var(--fail);font-size:13px;font-weight:600;margin:8px 0 0;display:none}
.controls .row-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:4px}
.btn-soft{background:var(--surface2);border:1px solid var(--line);color:var(--text);border-radius:12px;padding:10px 16px;font-weight:600;min-height:48px}
.btn-soft:hover{border-color:var(--brand);color:var(--brand)}

/* Sidebar */
.side{display:flex;flex-direction:column;gap:14px}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:16px;box-shadow:var(--shadow)}
.panel h2{font-size:15px;margin:0 0 4px;font-weight:800}
.panel .sub{font-size:12.5px;color:var(--muted);margin:0 0 12px}
table.grades{width:100%;border-collapse:collapse;font-size:13.5px}
table.grades th,table.grades td{padding:7px 8px;border-bottom:1px solid var(--line);text-align:left}
table.grades th{color:var(--muted);font-size:12px;letter-spacing:.04em;text-transform:uppercase}
table.grades tr:last-child td{border-bottom:none}
table.grades td.g{font-weight:800;width:52px}
table.grades tr.hl td{background:var(--brand-soft)}
.rule{border:1px solid var(--line);border-radius:13px;padding:11px 12px;margin-bottom:9px}
.rule:last-child{margin-bottom:0}
.rule b.head{display:flex;justify-content:space-between;gap:8px;font-size:13.5px;margin-bottom:5px}
.tag{font-size:11px;font-weight:800;padding:3px 8px;border-radius:999px;white-space:nowrap}
.tag.strict{background:var(--fail-bg);color:var(--fail);border:1px solid var(--fail-line)}
.tag.mid{background:var(--warn-bg);color:var(--warn);border:1px solid var(--warn-line)}
.tag.free{background:var(--pass-bg);color:var(--pass);border:1px solid var(--pass-line)}
.rule p{margin:0;font-size:13px;color:var(--muted);line-height:1.55}
.rule p strong{color:var(--text)}
.panel ol,.panel ul.steps{margin:0;padding-left:19px;font-size:13.5px;color:var(--muted)}
.panel ol li,.panel ul.steps li{margin:5px 0}
.panel ol li strong,.panel ul.steps li strong{color:var(--text)}
.note{font-size:12.5px;color:var(--muted);background:var(--surface2);border-radius:11px;padding:10px 12px;margin-top:12px;line-height:1.55}
.examples{display:flex;flex-wrap:wrap;gap:8px}
.ex-btn{border:1px solid var(--line);background:var(--surface2);color:var(--text);border-radius:999px;padding:8px 13px;font-size:12.5px;font-weight:600;min-height:40px}
.ex-btn:hover{border-color:var(--brand);color:var(--brand)}
footer{margin-top:18px;font-size:12.5px;color:var(--muted2);text-align:center;line-height:1.6;padding:0 8px}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
</style>
</head>
<body>
<div class="wrap">
  <div class="intro">
    <h1>Lọc khách theo hạng A-score</h1>
    <p>Trả lời 4 câu hỏi ngắn, chatbot tự đổi điểm thành hạng và đối chiếu chính sách thắt chặt để kết luận hồ sơ có qua được vòng này hay không — trước khi nộp.</p>
    <div class="meta-row">
      <span class="pill"><span class="dot"></span> Áp dụng từ <strong>&nbsp;30/10/2026</strong></span>
      <span class="pill">Hồ sơ mới đăng nhập hoặc được phê duyệt</span>
      <span class="pill">Truy vấn CIC: chỉ tính công ty tài chính, <strong>&nbsp;không tính SVFC</strong></span>
    </div>
  </div>

  <div class="layout">
    <!-- CHAT -->
    <section class="chat-card" aria-label="Chatbot lọc khách">
      <div class="chat-head">
        <div class="avatar" aria-hidden="true">A•S</div>
        <div class="who">
          <b>Trợ lý lọc hồ sơ</b>
          <span><span class="online"></span> Hỏi từng bước · kết luận ngay khi đủ thông tin</span>
        </div>
        <button class="btn-ghost" id="restartTop" type="button">↻ Làm lại</button>
      </div>
      <div class="progress" aria-hidden="true"><i id="progressBar"></i></div>
      <div class="step-label" id="stepLabel">Bước 1 / 4 — Điểm A-score</div>
      <div class="chat-log" id="chatLog" aria-live="polite"></div>
      <div class="controls" id="controls"></div>
    </section>

    <!-- SIDEBAR -->
    <aside class="side">
      <div class="panel">
        <h2>Bảng đổi điểm → hạng</h2>
        <p class="sub">Hạng của khách đang kiểm tra sẽ được tô sáng tự động.</p>
        <table class="grades" id="gradeTable">
          <thead><tr><th>Hạng</th><th>Điểm A-score</th></tr></thead>
          <tbody>
            <tr data-g="1"><td class="g">G1</td><td>Từ 653 trở lên</td></tr>
            <tr data-g="2"><td class="g">G2</td><td>635 – 652</td></tr>
            <tr data-g="3"><td class="g">G3</td><td>619 – 634</td></tr>
            <tr data-g="4"><td class="g">G4</td><td>605 – 618</td></tr>
            <tr data-g="5"><td class="g">G5</td><td>594 – 604</td></tr>
            <tr data-g="6"><td class="g">G6</td><td>585 – 593</td></tr>
            <tr data-g="7"><td class="g">G7</td><td>576 – 584</td></tr>
            <tr data-g="8"><td class="g">G8</td><td>568 – 575</td></tr>
            <tr data-g="9"><td class="g">G9</td><td>562 – 567</td></tr>
            <tr data-g="10"><td class="g">G10</td><td>Dưới 562</td></tr>
          </tbody>
        </table>
      </div>

      <div class="panel">
        <h2>Quy tắc loại theo nhóm</h2>
        <p class="sub">Chính sách thắt chặt chỉ nêu 3 nhóm dưới đây. G1–G3 không nằm trong đoạn thắt chặt này.</p>
        <div class="rule">
          <b class="head">G6 trở lên <span class="tag strict">Chặt nhất · dính 1 là loại</span></b>
          <p>Loại nếu: <strong>có truy vấn CIC trong 3 tháng</strong>, hoặc <strong>chưa có lịch sử tín dụng</strong>, hoặc không có truy vấn nhưng <strong>dư nợ giảm ≤ 8 tháng / không có dư nợ</strong> trong 12 tháng.</p>
        </div>
        <div class="rule">
          <b class="head">G5 <span class="tag mid">Loại khi đủ cả 2</span></b>
          <p>Loại nếu <strong>có truy vấn CIC trong 3 tháng</strong> <em>và</em> <strong>dư nợ giảm ≤ 3 tháng hoặc không có dư nợ</strong> trong 12 tháng.</p>
        </div>
        <div class="rule">
          <b class="head">G4 <span class="tag mid">Loại khi đủ cả 2</span></b>
          <p>Loại nếu <strong>có truy vấn CIC trong 3 tháng</strong> <em>và</em> <strong>dư nợ giảm ≤ 3 tháng</strong> trong 12 tháng.</p>
        </div>
        <div class="rule">
          <b class="head">G1 – G3 <span class="tag free">Không thuộc đoạn này</span></b>
          <p>Qua vòng thắt chặt A-score. Hồ sơ vẫn xét tiếp các điều kiện khác như bình thường.</p>
        </div>
      </div>

      <div class="panel">
        <h2>Cách đếm “tháng dư nợ giảm”</h2>
        <p class="sub">Đếm trên CIC hoặc sao kê khoản vay, không hỏi khách đoán.</p>
        <ol>
          <li>Lấy dư nợ vay của <strong>12 tháng gần nhất</strong>, xếp theo từng tháng.</li>
          <li>Tháng nào dư nợ <strong>thấp hơn tháng liền trước</strong> thì tính 1 tháng giảm.</li>
          <li>Cộng lại: ra con số chatbot hỏi ở bước cuối. Ví dụ giảm đều mỗi tháng là <strong>9–12 tháng</strong>.</li>
        </ol>
        <div class="note">Khách không có khoản vay nào trong 12 tháng thì chọn “Không có dư nợ” — với G5 và G6 trở lên, trường hợp này bị tính vào điều kiện loại như trong quy tắc.</div>
      </div>

      <div class="panel">
        <h2>Thử nhanh một ví dụ</h2>
        <p class="sub">Bấm để chatbot tự chạy một trường hợp mẫu.</p>
        <div class="examples">
          <button class="ex-btn" type="button" data-ex="pass">G2 — 640 điểm</button>
          <button class="ex-btn" type="button" data-ex="g5fail">G5 — bị truy vấn, giảm 2 tháng</button>
          <button class="ex-btn" type="button" data-ex="g6pass">G7 — sạch, giảm 10 tháng</button>
          <button class="ex-btn" type="button" data-ex="g6fail">G8 — chưa có lịch sử tín dụng</button>
        </div>
      </div>
    </aside>
  </div>

  <footer>Kết quả của chatbot chỉ là vòng thắt chặt theo hạng A-score áp dụng từ 30/10/2026, không thay cho kết quả phê duyệt chính thức. Khi thông tin chưa rõ, hãy tra CIC trước khi kết luận.</footer>
</div>

<script>
(function(){
  var log = document.getElementById('chatLog');
  var controls = document.getElementById('controls');
  var bar = document.getElementById('progressBar');
  var stepLabel = document.getElementById('stepLabel');
  var state = null;

  function freshState(){
    return { score:null, grade:null, gradeNum:null, hasHistory:null, hasQuery:null, hasBalance:null, months:null, step:'score' };
  }
  function gradeFromScore(s){
    if(s>=653) return {g:'G1',n:1};
    if(s>=635) return {g:'G2',n:2};
    if(s>=619) return {g:'G3',n:3};
    if(s>=605) return {g:'G4',n:4};
    if(s>=594) return {g:'G5',n:5};
    if(s>=585) return {g:'G6',n:6};
    if(s>=576) return {g:'G7',n:7};
    if(s>=568) return {g:'G8',n:8};
    if(s>=562) return {g:'G9',n:9};
    return {g:'G10',n:10};
  }
  function esc(t){ return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;'); }
  function scrollLog(){ log.scrollTop = log.scrollHeight; }
  function addMsg(who, html){
    var d=document.createElement('div'); d.className='msg '+who;
    d.innerHTML='<div class="mini" aria-hidden="true">'+(who==='bot'?'A•S':'NV')+'</div><div class="bubble">'+html+'</div>';
    log.appendChild(d); scrollLog(); return d;
  }
  function typingThen(html, cb){
    var t=document.createElement('div'); t.className='msg bot';
    t.innerHTML='<div class="mini" aria-hidden="true">A•S</div><div class="typing" aria-hidden="true"><i></i><i></i><i></i></div>';
    log.appendChild(t); scrollLog();
    setTimeout(function(){ t.remove(); addMsg('bot', html); if(cb) cb(); }, 480);
  }
  function setProgress(pct, label){ bar.style.width=pct+'%'; stepLabel.textContent=label; }
  function highlightGrade(n){
    var rows=document.querySelectorAll('#gradeTable tbody tr');
    rows.forEach(function(r){ r.classList.toggle('hl', Number(r.getAttribute('data-g'))===n); });
  }
  function yn(v){ return v===true?'Có':(v===false?'Không':'Chưa rõ'); }

  function summaryTable(){
    var rows='';
    rows+='<tr><th>Điểm / Hạng</th><td>'+state.score+' điểm — '+state.grade+'</td></tr>';
    if(state.hasHistory!==null) rows+='<tr><th>Lịch sử tín dụng</th><td>'+(state.hasHistory===true?'Đã có':(state.hasHistory===false?'Chưa có':'Chưa rõ'))+'</td></tr>';
    if(state.hasQuery!==null) rows+='<tr><th>Truy vấn CIC 3 tháng gần nhất</th><td>'+yn(state.hasQuery)+'</td></tr>';
    if(state.hasBalance!==null) rows+='<tr><th>Dư nợ vay 12 tháng gần nhất</th><td>'+(state.hasBalance?'Có dư nợ':'Không có dư nợ')+'</td></tr>';
    if(state.months!==null) rows+='<tr><th>Số tháng dư nợ giảm</th><td>'+state.months+' tháng</td></tr>';
    return '<table>'+rows+'</table>';
  }

  function showResult(kind, verdict, why, next){
    var icon = kind==='pass' ? '✓' : (kind==='fail' ? '✕' : '!');
    var html='<div class="result '+kind+'"><div class="verdict"><span aria-hidden="true">'+icon+'</span><span>'+verdict+'</span></div>'
      +'<div class="why">'+why+'</div>'+summaryTable()
      +'<div class="next"><strong>Việc nên làm tiếp:</strong> '+next+'</div></div>';
    addMsg('bot', html);
    setProgress(100,'Hoàn tất — đã có kết luận');
    controls.innerHTML='<div class="row-actions">'
      +'<button class="btn-main" id="btnAgain" type="button">Kiểm tra khách mới</button>'
      +'<button class="btn-soft" id="btnCopy" type="button">Sao chép kết luận</button></div>'
      +'<p class="hint" style="margin-top:10px">Sao chép để dán vào ghi chú hồ sơ. Kết luận chỉ tính vòng thắt chặt A-score, hồ sơ vẫn phải qua các điều kiện phê duyệt khác.</p>';
    document.getElementById('btnAgain').addEventListener('click', start);
    document.getElementById('btnCopy').addEventListener('click', function(){
      var txt='Lọc A-score: '+state.score+' điểm ('+state.grade+') — '+verdict.replace(/<[^>]+>/g,'')
        +' | Lịch sử tín dụng: '+(state.hasHistory===null?'—':(state.hasHistory?'Đã có':'Chưa có'))
        +' | Truy vấn CIC 3 tháng: '+(state.hasQuery===null?'—':yn(state.hasQuery))
        +' | Dư nợ 12 tháng: '+(state.hasBalance===null?'—':(state.hasBalance?'Có':'Không'))
        +' | Tháng dư nợ giảm: '+(state.months===null?'—':state.months+' tháng');
      var btn=this;
      if(navigator.clipboard && navigator.clipboard.writeText){
        navigator.clipboard.writeText(txt).then(function(){ btn.textContent='✓ Đã sao chép'; setTimeout(function(){btn.textContent='Sao chép kết luận';},1800); });
      } else {
        var ta=document.createElement('textarea'); ta.value=txt; document.body.appendChild(ta); ta.select();
        try{document.execCommand('copy'); btn.textContent='✓ Đã sao chép';}catch(e){}
        ta.remove(); setTimeout(function(){btn.textContent='Sao chép kết luận';},1800);
      }
    });
  }

  /* ---------- Steps ---------- */
  function askScore(){
    state.step='score'; setProgress(12,'Bước 1 / 4 — Điểm A-score');
    controls.innerHTML='<p class="hint">Nhập điểm A-score trên CIC / hệ thống của khách, ví dụ 610.</p>'
      +'<form class="score-form" id="scoreForm"><label class="sr-only" for="scoreInput">Điểm A-score</label>'
      +'<input id="scoreInput" type="number" inputmode="numeric" min="300" max="1000" placeholder="Nhập điểm, ví dụ 610" autocomplete="off">'
      +'<button class="btn-main" type="submit">Tiếp tục →</button></form>'
      +'<p class="err" id="scoreErr">Điểm chưa hợp lệ — nhập một số từ 300 đến 1000.</p>';
    var input=document.getElementById('scoreInput'); input.focus();
    document.getElementById('scoreForm').addEventListener('submit', function(e){
      e.preventDefault();
      var v=parseInt(input.value,10);
      if(isNaN(v)||v<300||v>1000){ document.getElementById('scoreErr').style.display='block'; return; }
      state.score=v; var gr=gradeFromScore(v); state.grade=gr.g; state.gradeNum=gr.n;
      highlightGrade(gr.n);
      addMsg('user','Điểm A-score: <strong>'+v+'</strong>');
      if(gr.n<=3){
        typingThen('<p>'+v+' điểm thuộc hạng <strong>'+gr.g+'</strong>.</p><p>Hạng G1–G3 không nằm trong đoạn thắt chặt này nên không cần hỏi thêm.</p>', function(){
          showResult('pass','ĐỦ ĐIỀU KIỆN qua vòng thắt chặt A-score',
            'Khách hạng '+gr.g+' ('+v+' điểm) không thuộc nhóm bị thắt chặt theo chính sách này.',
            'Nộp hồ sơ và xét tiếp các điều kiện phê duyệt khác như bình thường.');
        });
      } else if(gr.n===4||gr.n===5){
        typingThen('<p>'+v+' điểm thuộc hạng <strong>'+gr.g+'</strong> — nhóm này chỉ bị loại khi <strong>đủ cả 2 điều kiện</strong> cùng lúc. Em hỏi tiếp 2 ý nữa là kết luận được.</p>', askQuery);
      } else {
        typingThen('<p>'+v+' điểm thuộc hạng <strong>'+gr.g+'</strong> — nhóm <strong>G6 trở lên, chặt nhất</strong>: chỉ cần dính 1 điều kiện loại là không qua. Em kiểm tra lần lượt từng ý.</p>', askHistory);
      }
    });
  }

  function choiceControls(hint, options){
    var h='<p class="hint">'+hint+'</p><div class="choices">';
    options.forEach(function(o,i){ h+='<button class="choice'+(o.primary?' primary':'')+'" type="button" data-i="'+i+'">'+o.label+(o.sub?'<small>'+o.sub+'</small>':'')+'</button>'; });
    h+='</div>'; controls.innerHTML=h;
    controls.querySelectorAll('.choice').forEach(function(btn){
      btn.addEventListener('click', function(){ options[Number(btn.getAttribute('data-i'))].onPick(); });
    });
  }

  function askHistory(){
    state.step='history'; setProgress(36,'Bước 2 / 4 — Lịch sử tín dụng');
    typingThen('<p><strong>Câu 2:</strong> Khách đã từng có lịch sử tín dụng chưa?</p><p>Tức là đã từng vay, mở thẻ tín dụng hoặc mua trả góp ở bất kỳ đâu và được ghi nhận trên CIC.</p><div class="say">Cách hỏi khách: <b>“Trước giờ anh/chị đã từng vay, mở thẻ hay mua trả góp ở đâu chưa ạ?”</b></div>');
    choiceControls('Ý này quyết định ngay với nhóm G6 trở lên: chưa có lịch sử tín dụng là loại.', [
      {label:'Đã có lịch sử tín dụng', onPick:function(){ state.hasHistory=true; addMsg('user','Đã có lịch sử tín dụng'); askQuery(); }},
      {label:'Chưa từng có', sub:'Chưa vay / mở thẻ / trả góp lần nào', onPick:function(){ state.hasHistory=false; addMsg('user','Chưa có lịch sử tín dụng');
        typingThen('<p>Thông tin này đủ để kết luận rồi, không cần hỏi tiếp.</p>', function(){
          showResult('fail','KHÔNG ĐỦ ĐIỀU KIỆN theo chính sách thắt chặt',
            'Khách hạng '+state.grade+' thuộc nhóm G6 trở lên và <strong>chưa có lịch sử tín dụng</strong> — đây là 1 trong 3 điều kiện loại của nhóm này, dính 1 điều là loại.',
            'Không nộp hồ sơ ở thời điểm này. Giải thích nhẹ nhàng với khách và hẹn khi khách đã có lịch sử tín dụng ổn định.');
        }); }},
      {label:'Chưa rõ', sub:'Cần tra CIC mới biết chắc', onPick:function(){ state.hasHistory='unknown'; addMsg('user','Chưa rõ lịch sử tín dụng'); askQuery(); }}
    ]);
  }

  function askQuery(){
    state.step='query';
    setProgress(state.gradeNum>=6?58:52,'Bước '+(state.gradeNum>=6?'3':'2')+' — Truy vấn CIC 3 tháng gần nhất');
    typingThen('<p><strong>Câu tiếp theo:</strong> Trong <strong>3 tháng gần nhất</strong>, có công ty tài chính nào truy vấn CIC của khách không?</p><p>Chỉ tính công ty tài chính, <strong>không tính SVFC</strong>.</p><div class="say">Cách hỏi khách: <b>“3 tháng gần đây anh/chị có làm hồ sơ vay ở bên tài chính nào không, hoặc có bên nào kiểm tra hồ sơ của anh/chị không?”</b></div>');
    choiceControls('Nếu khách vừa làm hồ sơ ở một công ty tài chính khác trong 3 tháng qua thì thường là “Có”.', [
      {label:'Có — bị truy vấn ≥ 1 lần', onPick:function(){ state.hasQuery=true; addMsg('user','Có bị truy vấn CIC trong 3 tháng gần nhất');
        if(state.gradeNum>=6){
          typingThen('<p>Với nhóm G6 trở lên, chỉ riêng ý này đã đủ để loại, không cần hỏi tiếp.</p>', function(){
            showResult('fail','KHÔNG ĐỦ ĐIỀU KIỆN theo chính sách thắt chặt',
              'Khách hạng '+state.grade+' thuộc nhóm G6 trở lên và <strong>có ít nhất 1 lần bị công ty tài chính truy vấn CIC trong 3 tháng gần nhất</strong> — dính 1 trong 3 điều kiện loại.',
              'Không nộp hồ sơ lúc này. Có thể hẹn khách quay lại sau khi qua mốc 3 tháng kể từ lần truy vấn gần nhất, rồi kiểm tra lại từ đầu.');
          });
        } else { askBalance(); } }},
      {label:'Không — không bị truy vấn', onPick:function(){ state.hasQuery=false; addMsg('user','Không bị truy vấn CIC trong 3 tháng gần nhất');
        if(state.gradeNum===4||state.gradeNum===5){
          typingThen('<p>Nhóm '+state.grade+' chỉ bị loại khi <strong>đủ cả 2 điều kiện</strong>. Đã không có truy vấn thì điều kiện còn lại không cần xét nữa.</p>', function(){
            showResult('pass','ĐỦ ĐIỀU KIỆN qua vòng thắt chặt A-score',
              'Khách hạng '+state.grade+' <strong>không bị truy vấn CIC trong 3 tháng gần nhất</strong>, nên không thể dính cặp điều kiện loại của nhóm '+state.grade+'.',
              'Nộp hồ sơ và xét tiếp các điều kiện phê duyệt khác như bình thường.');
          });
        } else { askBalance(); } }},
      {label:'Chưa rõ', sub:'Cần tra CIC mới biết chắc', onPick:function(){ state.hasQuery='unknown'; addMsg('user','Chưa rõ truy vấn CIC 3 tháng gần nhất'); askBalance(); }}
    ]);
  }

  function askBalance(){
    state.step='balance'; setProgress(78,'Bước kế tiếp — Dư nợ vay 12 tháng gần nhất');
    typingThen('<p><strong>Câu tiếp theo:</strong> Trong <strong>12 tháng gần nhất</strong>, khách có dư nợ vay không?</p><p>Xem trên CIC hoặc sao kê khoản vay — phần này đối chiếu giấy tờ, không hỏi khách đoán.</p>');
    choiceControls('', [
      {label:'Có dư nợ vay', sub:'Có ít nhất một tháng có dư nợ trong 12 tháng qua', onPick:function(){ state.hasBalance=true; addMsg('user','Có dư nợ vay trong 12 tháng gần nhất'); askMonths(); }},
      {label:'Không có dư nợ vay', sub:'Suốt 12 tháng không có khoản vay nào', onPick:function(){ state.hasBalance=false; state.months=0; addMsg('user','Không có dư nợ vay trong 12 tháng gần nhất'); finishFromBalance(); }}
    ]);
  }

  function finishFromBalance(){
    if(state.gradeNum>=6){
      if(state.hasQuery==='unknown'||state.hasHistory==='unknown'){ return showVerify('Khách không có dư nợ vay trong 12 tháng — với nhóm G6 trở lên đây là ý thuộc điều kiện loại khi không có truy vấn CIC. Cần tra CIC để chốt ý truy vấn / lịch sử tín dụng trước khi kết luận.'); }
      showResult('fail','KHÔNG ĐỦ ĐIỀU KIỆN theo chính sách thắt chặt',
        'Khách hạng '+state.grade+' không bị truy vấn trong 3 tháng nhưng <strong>không có dư nợ vay trong 12 tháng gần nhất</strong> — dính điều kiện loại thứ 3 của nhóm G6 trở lên.',
        'Không nộp hồ sơ ở thời điểm này; tư vấn khách xây dựng lịch sử vay và trả nợ đều trước khi làm lại hồ sơ.');
    } else if(state.gradeNum===5){
      if(state.hasQuery==='unknown'){ return showVerify('Khách G5 không có dư nợ vay — đây là một nửa của cặp điều kiện loại. Cần tra CIC để biết có bị truy vấn trong 3 tháng gần nhất hay không.'); }
      showResult('fail','KHÔNG ĐỦ ĐIỀU KIỆN theo chính sách thắt chặt',
        'Khách hạng G5 có đủ cả 2 điều: <strong>bị truy vấn CIC trong 3 tháng gần nhất</strong> và <strong>không có dư nợ vay trong 12 tháng gần nhất</strong>.',
        'Không nộp hồ sơ lúc này; hẹn khách quay lại sau mốc 3 tháng kể từ lần truy vấn gần nhất rồi kiểm tra lại.');
    } else { /* G4: no balance => months = 0 <= 3 */
      if(state.hasQuery==='unknown'){ return showVerify('Khách G4 không có dư nợ vay (số tháng giảm = 0). Cần tra CIC để biết có bị truy vấn trong 3 tháng gần nhất hay không.'); }
      showResult('fail','KHÔNG ĐỦ ĐIỀU KIỆN theo chính sách thắt chặt',
        'Khách hạng G4 có đủ cả 2 điều: <strong>bị truy vấn CIC trong 3 tháng gần nhất</strong> và số tháng dư nợ giảm là <strong>0 tháng (≤ 3 tháng)</strong>.',
        'Không nộp hồ sơ lúc này; hẹn khách quay lại sau mốc 3 tháng kể từ lần truy vấn gần nhất rồi kiểm tra lại.');
    }
  }

  function askMonths(){
    state.step='months'; setProgress(90,'Bước cuối — Số tháng dư nợ giảm');
    var isG6 = state.gradeNum>=6;
    typingThen('<p><strong>Câu cuối:</strong> Trong 12 tháng gần nhất, dư nợ vay của khách <strong>giảm được mấy tháng</strong>?</p><p>Đếm tháng mà dư nợ thấp hơn tháng liền trước, đối chiếu trên CIC / sao kê. '+(isG6?'Nhóm G6 trở lên cần <strong>trên 8 tháng</strong> mới qua.':'Nhóm '+state.grade+' bị loại ở mức <strong>từ 3 tháng trở xuống</strong> khi đã có truy vấn CIC.')+'</p>');
    var h='<p class="hint">Chọn số tháng dư nợ giảm (0 – 12):</p><div class="months-grid" role="group" aria-label="Số tháng dư nợ giảm">';
    for(var i=0;i<=12;i++){
      var zone = isG6 ? (i<=8?'zone-bad':'zone-good') : (i<=3?'zone-bad':'zone-good');
      h+='<button class="month-btn '+zone+'" type="button" data-m="'+i+'">'+i+'</button>';
    }
    h+='</div>'; controls.innerHTML=h;
    controls.querySelectorAll('.month-btn').forEach(function(btn){
      btn.addEventListener('click', function(){
        state.months=Number(btn.getAttribute('data-m'));
        addMsg('user','Dư nợ giảm '+state.months+' tháng trong 12 tháng gần nhất');
        finishFromMonths();
      });
    });
  }

  function showVerify(why){
    showResult('warn','CHƯA KẾT LUẬN ĐƯỢC — cần tra CIC trước',
      why,
      'Tra CIC của khách để chốt các ý còn “chưa rõ”, rồi chạy lại chatbot này với thông tin chắc chắn.');
  }

  function finishFromMonths(){
    var m=state.months;
    if(state.hasQuery==='unknown'||state.hasHistory==='unknown'){
      /* Still can sometimes conclude: G6+ with months<=8 and no query known? Not safe. Verify. */
      return showVerify('Còn ý “chưa rõ” về '+(state.hasHistory==='unknown'?'lịch sử tín dụng':'truy vấn CIC 3 tháng')+' nên chưa chốt được kết luận cho hồ sơ hạng '+state.grade+'.');
    }
    if(state.gradeNum>=6){
      if(m<=8){
        showResult('fail','KHÔNG ĐỦ ĐIỀU KIỆN theo chính sách thắt chặt',
          'Khách hạng '+state.grade+' không bị truy vấn trong 3 tháng, đã có lịch sử tín dụng, nhưng dư nợ chỉ giảm <strong>'+m+' tháng (≤ 8 tháng)</strong> trong 12 tháng gần nhất — dính điều kiện loại thứ 3 của nhóm G6 trở lên.',
          'Không nộp hồ sơ ở thời điểm này; tư vấn khách duy trì trả nợ đều để số tháng dư nợ giảm vượt 8 tháng rồi kiểm tra lại.');
      } else {
        showResult('pass','ĐỦ ĐIỀU KIỆN qua vòng thắt chặt A-score',
          'Khách hạng '+state.grade+' đạt cả 3 ý an toàn của nhóm G6 trở lên: <strong>đã có lịch sử tín dụng</strong>, <strong>không bị truy vấn CIC trong 3 tháng</strong> và dư nợ giảm <strong>'+m+' tháng (trên 8 tháng)</strong> trong 12 tháng gần nhất.',
          'Nộp hồ sơ và xét tiếp các điều kiện phê duyệt khác như bình thường.');
      }
    } else if(state.gradeNum===5){
      if(state.hasQuery && m<=3){
        showResult('fail','KHÔNG ĐỦ ĐIỀU KIỆN theo chính sách thắt chặt',
          'Khách hạng G5 có đủ cả 2 điều: <strong>bị truy vấn CIC trong 3 tháng gần nhất</strong> và dư nợ chỉ giảm <strong>'+m+' tháng (≤ 3 tháng)</strong> trong 12 tháng gần nhất.',
          'Không nộp hồ sơ lúc này; hẹn khách quay lại sau mốc 3 tháng kể từ lần truy vấn gần nhất rồi kiểm tra lại.');
      } else {
        showResult('pass','ĐỦ ĐIỀU KIỆN qua vòng thắt chặt A-score',
          'Khách hạng G5 bị truy vấn trong 3 tháng nhưng dư nợ giảm <strong>'+m+' tháng (trên 3 tháng)</strong>, nên chưa đủ cặp điều kiện loại của nhóm G5.',
          'Nộp hồ sơ và xét tiếp các điều kiện phê duyệt khác như bình thường.');
      }
    } else { /* G4 */
      if(state.hasQuery && m<=3){
        showResult('fail','KHÔNG ĐỦ ĐIỀU KIỆN theo chính sách thắt chặt',
          'Khách hạng G4 có đủ cả 2 điều: <strong>bị truy vấn CIC trong 3 tháng gần nhất</strong> và dư nợ chỉ giảm <strong>'+m+' tháng (≤ 3 tháng)</strong> trong 12 tháng gần nhất.',
          'Không nộp hồ sơ lúc này; hẹn khách quay lại sau mốc 3 tháng kể từ lần truy vấn gần nhất rồi kiểm tra lại.');
      } else {
        showResult('pass','ĐỦ ĐIỀU KIỆN qua vòng thắt chặt A-score',
          'Khách hạng G4 bị truy vấn trong 3 tháng nhưng dư nợ giảm <strong>'+m+' tháng (trên 3 tháng)</strong>, nên chưa đủ cặp điều kiện loại của nhóm G4.',
          'Nộp hồ sơ và xét tiếp các điều kiện phê duyệt khác như bình thường.');
      }
    }
  }

  /* ---------- Start / examples ---------- */
  function start(){
    state=freshState(); log.innerHTML=''; highlightGrade(-1);
    addMsg('bot','<p>Chào anh/chị, em là trợ lý lọc hồ sơ theo <strong>chính sách thắt chặt A-score</strong> (áp dụng cho hồ sơ mới từ 30/10/2026).</p><p>Em chỉ hỏi tối đa 4 ý: <strong>điểm A-score → lịch sử tín dụng → truy vấn CIC 3 tháng → dư nợ 12 tháng</strong>. Hồ sơ nào loại sớm, em kết luận ngay, không hỏi thừa.</p><p><strong>Câu 1:</strong> Điểm A-score của khách là bao nhiêu?</p>');
    askScore();
  }
  function runExample(kind){
    start();
    setTimeout(function(){
      var scoreInput=document.getElementById('scoreInput');
      var form=document.getElementById('scoreForm');
      var cfg={ pass:{s:640}, g5fail:{s:600}, g6pass:{s:580}, g6fail:{s:572} }[kind];
      scoreInput.value=cfg.s;
      form.dispatchEvent(new Event('submit',{cancelable:true}));
      /* Walk the example through with timed picks */
      function pickChoice(idx){ var b=controls.querySelectorAll('.choice'); if(b[idx]) b[idx].click(); }
      function pickMonth(m){ var b=controls.querySelector('[data-m="'+m+'"]'); if(b) b.click(); }
      if(kind==='g5fail'){ setTimeout(function(){pickChoice(0);},1100); setTimeout(function(){pickChoice(0);},2300); setTimeout(function(){pickMonth(2);},3500); }
      if(kind==='g6pass'){ setTimeout(function(){pickChoice(0);},1100); setTimeout(function(){pickChoice(1);},2300); setTimeout(function(){pickChoice(0);},3500); setTimeout(function(){pickMonth(10);},4700); }
      if(kind==='g6fail'){ setTimeout(function(){pickChoice(1);},1100); }
      document.querySelector('.chat-card').scrollIntoView({behavior:'smooth',block:'start'});
    },150);
  }
  document.getElementById('restartTop').addEventListener('click', start);
  document.querySelectorAll('[data-ex]').forEach(function(b){ b.addEventListener('click', function(){ runExample(b.getAttribute('data-ex')); }); });
  start();
})();
</script>
